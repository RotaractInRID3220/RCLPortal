{
  "name": "rcl-portal",
  "version": "1.5.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/migrate.mjs --seed",
    "db:status": "node scripts/migrate.mjs --status",
    "db:mock": "node scripts/migrate.mjs --mock",
    "mock:rmis": "node scripts/mock-rmis.mjs",
    "worker": "node scripts/worker.mjs",
    "test": "node scripts/guard-test-db.mjs && node --test --test-concurrency=1 tests/",
    "db:pull": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs pull --config drizzle.config.mjs && node scripts/drizzle-schema.mjs",
    "tunnel:vps": "bash scripts/vps-tunnel.sh",
    "dev:vps": "node --env-file=.env.vps.local node_modules/next/dist/bin/next dev",
    "db:status:vps": "node --env-file=.env.vps.local scripts/migrate.mjs --status",
    "db:migrate:vps": "node --env-file=.env.vps.local scripts/migrate.mjs",
    "worker:vps": "node --env-file=.env.vps.local scripts/worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.13.0",
    "html5-qrcode": "^2.3.8",
    "jotai": "^2.13.1",
    "lucide-react": "^0.539.0",
    "next": "15.4.10",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-brackets": "^0.4.7",
    "react-day-picker": "^9.8.1",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "react-brackets": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6"
  }
}
